# Copy to .env (gitignored) and fill in. Read by the app, Alembic and tests (cdms.config.Settings).

# PostgreSQL connection (the Docker container's published host / port)
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=

# Application database
DB_NAME=cdms
# Test database: wiped and re-migrated by every integration test run - never point it at real data
DB_TEST_NAME=cdms_test

LOG_LEVEL=INFO

# Vietful emulator (cdms.emulator, port 8101): static bearer token for its /api/v1 routes; any random string
INVENTORY_API_TOKEN=
