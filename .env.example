# Copy to .env (gitignored) and fill in. Read by the app, Alembic and tests (cdms.config.Settings).

# PostgreSQL connection (the Docker container's published host / port)
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=

# Application database
DB_NAME=cdms
# Test database: wiped and re-migrated by every integration test run - never point it at real data
DB_TEST_NAME=cdms_test
# Seconds to wait for a new DB connection before failing (API answers 503 instead of hanging)
# DB_CONNECT_TIMEOUT_S=5

LOG_LEVEL=INFO

# Vietful emulator (cdms.emulator, port 8101): static bearer token for its /api/v1 routes; any random string
INVENTORY_API_TOKEN=
# Inventory service used by CDMS polling (default: the local emulator)
INVENTORY_BASE_URL=http://localhost:8101
# Webhook HMAC secret shared by CDMS (verifies) and the emulator (signs callbacks); any random string
WEBHOOK_SECRET=
